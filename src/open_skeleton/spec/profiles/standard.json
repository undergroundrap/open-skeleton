{
  "schema": "open-skeleton.spec_profile.v1",
  "profile_id": "standard-technical-specification",
  "profile_version": "v1",
  "title": "Technical Specification",
  "lineage": "Conventional software specification taxonomy — ISO/IEC/IEEE 29148 requirements structure, C4 architectural levels, and a standard operational-readiness checklist. Each node is bound to the analyzer claim categories and probes that can actually decide it for a given repository.",
  "sections": [
    {
      "id": "introduction",
      "number": "1",
      "title": "Introduction",
      "concern": "What this repository is and where execution begins.",
      "children": [
        {
          "id": "introduction.composition",
          "number": "1.1",
          "title": "Repository Composition",
          "concern": "What the scanner included, what it excluded, and why.",
          "panels": [
            "snapshot_totals",
            "language_census",
            "role_census",
            "largest_files",
            "exclusions"
          ],
          "framing": "Every percentage elsewhere in this document is relative to the included set below. Excluded content was never read."
        },
        {
          "id": "introduction.consequences",
          "number": "1.2",
          "title": "What These Findings Imply",
          "concern": "Engineering consequences that follow from combinations of findings.",
          "panels": [
            "consequences"
          ],
          "framing": "Each row below composes claims established elsewhere in this document. A consequence is not a new fact and not a recommendation: it states what follows if the cited claims hold, and it holds exactly as far as they do."
        },
        {
          "id": "introduction.entry-points",
          "number": "1.3",
          "title": "Entry Points",
          "concern": "Executable entry points and application bootstrap.",
          "probes": [
            {
              "name": "Declared entry points",
              "kind": "sourced_claim_category",
              "terms": [
                "application_entry"
              ]
            }
          ],
          "findings": {
            "categories": [
              "application_entry"
            ],
            "limit": 20
          },
          "cross_references": [
            "stack.languages"
          ]
        },
        {
          "id": "introduction.concentration",
          "number": "1.4",
          "title": "Architectural Concentration",
          "concern": "Where implementation mass accumulates, and the maintenance risk that follows.",
          "probes": [
            {
              "name": "Concentration findings",
              "kind": "sourced_claim_category",
              "terms": [
                "concentration"
              ]
            }
          ],
          "findings": {
            "categories": [
              "concentration"
            ],
            "limit": 15
          },
          "diagrams": [
            "concentration"
          ]
        }
      ]
    },
    {
      "id": "surface",
      "number": "2",
      "title": "Functional Surface and Capabilities",
      "concern": "The behavior this system exposes to callers, and how it traces to verification.",
      "children": [
        {
          "id": "surface.http",
          "number": "2.1",
          "title": "HTTP Interface",
          "concern": "Routes the implementation actually serves.",
          "probes": [
            {
              "name": "Verified routes",
              "kind": "claim_category",
              "terms": [
                "http_route"
              ]
            },
            {
              "name": "Route inventory",
              "kind": "claim_category",
              "terms": [
                "http_route_inventory"
              ]
            }
          ],
          "findings": {
            "categories": [
              "http_route_inventory"
            ],
            "limit": 10
          },
          "diagrams": [
            "route_surface",
            "route_sequence",
            "handler_flow"
          ],
          "cross_references": [
            "surface.interface-drift",
            "security.authentication"
          ]
        },
        {
          "id": "surface.interface-drift",
          "number": "2.2",
          "title": "Documented Versus Implemented Interface",
          "concern": "Divergence between the documented API and the served API.",
          "probes": [
            {
              "name": "Documented route inventory",
              "kind": "claim_category",
              "terms": [
                "documented_http_route_inventory"
              ]
            },
            {
              "name": "API documentation drift",
              "kind": "sourced_claim_category",
              "terms": [
                "api_documentation_drift"
              ]
            }
          ],
          "findings": {
            "categories": [
              "api_documentation_drift",
              "documented_http_route_inventory"
            ],
            "limit": 20
          }
        },
        {
          "id": "surface.domain-rules",
          "number": "2.3",
          "title": "Domain Rules and Numeric Models",
          "concern": "Quantitative rules encoded in the implementation.",
          "probes": [
            {
              "name": "Scaling rules",
              "kind": "claim_category",
              "terms": [
                "exponential_scaling"
              ]
            },
            {
              "name": "Numeric conflicts",
              "kind": "sourced_claim_category",
              "terms": [
                "mathematical_conflict"
              ]
            }
          ],
          "findings": {
            "categories": [
              "exponential_scaling",
              "mathematical_conflict"
            ],
            "limit": 20
          }
        },
        {
          "id": "surface.capability-catalog",
          "number": "2.4",
          "title": "Implemented Capability Catalog",
          "concern": "Clusters of behavior the implementation actually exposes.",
          "panels": [
            "capability_catalog"
          ],
          "framing": "A requirement is a statement of intent, and source code is not intent. This catalog therefore records implemented capabilities recovered from served route prefixes and source module structure. It does not claim to reconstruct what anyone asked for.",
          "cross_references": [
            "surface.http",
            "surface.traceability"
          ]
        },
        {
          "id": "surface.traceability",
          "number": "2.5",
          "title": "Capability Traceability",
          "concern": "Which files implement each capability and what exercises it.",
          "panels": [
            "traceability_matrix"
          ],
          "framing": "Each row is computed, not asserted. Implementing files come from symbol receipts; the exercising column follows call edges out of test-role files and operator-harness scripts into the capability's symbols. Every cell can be re-derived from the ledger.",
          "cross_references": [
            "verification.tests",
            "verification.operator-harness"
          ]
        },
        {
          "id": "surface.verification-gaps",
          "number": "2.6",
          "title": "Capabilities Without a Verifying Reference",
          "concern": "Implemented behavior that no test or harness reaches.",
          "panels": [
            "verification_gaps"
          ],
          "framing": "A missing reference means no call edge was found from a verifying file into the capability's symbols. Static call resolution cannot observe dynamic dispatch or end-to-end HTTP exercise, so each row is a candidate for review rather than proof that the capability is untested.",
          "cross_references": [
            "verification.gaps"
          ]
        },
        {
          "id": "surface.dossiers",
          "number": "2.7",
          "title": "Capability Dossiers",
          "concern": "Everything known about one capability, assembled in one place.",
          "framing": "Each dossier groups records established elsewhere in this document under the capability whose files they touch. It adds no fact; the grouping is the point, because a reader changing one capability should not have to reassemble it from six sections.",
          "cross_references": [
            "surface.capability-catalog",
            "surface.traceability"
          ]
        }
      ]
    },
    {
      "id": "stack",
      "number": "3",
      "title": "Technology Stack",
      "concern": "Languages, modules, and declared third-party surface.",
      "children": [
        {
          "id": "stack.languages",
          "number": "3.1",
          "title": "Languages and Module Graph",
          "concern": "Implementation languages and internal module relationships.",
          "probes": [
            {
              "name": "Module symbols",
              "kind": "symbol_kind",
              "terms": [
                "module"
              ]
            },
            {
              "name": "Import relationships",
              "kind": "edge_relationship",
              "terms": [
                "imports"
              ]
            }
          ],
          "diagrams": [
            "module_dependency",
            "function_flow"
          ]
        },
        {
          "id": "stack.dependencies",
          "number": "3.2",
          "title": "Declared Dependencies",
          "concern": "Third-party packages declared by project manifests.",
          "probes": [
            {
              "name": "Dependency manifests",
              "kind": "path_glob",
              "terms": [
                "package.json",
                "requirements*.txt",
                "pyproject.toml",
                "Cargo.toml",
                "go.mod",
                "Gemfile",
                "*.csproj"
              ]
            },
            {
              "name": "Dependency inventory",
              "kind": "claim_category",
              "terms": [
                "dependency_inventory"
              ]
            },
            {
              "name": "Dependency declarations",
              "kind": "edge_relationship",
              "terms": [
                "declares_dependency"
              ]
            }
          ],
          "findings": {
            "categories": [
              "dependency_inventory",
              "dependency_drift"
            ],
            "limit": 25
          }
        },
        {
          "id": "stack.documentation",
          "number": "3.3",
          "title": "Documentation Conformance",
          "concern": "Statements in repository documentation that the implementation does not support.",
          "probes": [
            {
              "name": "Documentation files",
              "kind": "file_role",
              "terms": [
                "documentation"
              ]
            },
            {
              "name": "Documentation drift",
              "kind": "sourced_claim_category",
              "terms": [
                "documentation_drift"
              ]
            }
          ],
          "findings": {
            "categories": [
              "documentation_drift"
            ],
            "limit": 25
          }
        },
        {
          "id": "stack.licensing",
          "number": "3.4",
          "title": "License and Supply-Chain Artifacts",
          "concern": "License declarations and machine-readable bill-of-materials artifacts.",
          "probes": [
            {
              "name": "License declarations",
              "kind": "path_glob",
              "terms": [
                "LICENSE",
                "LICENSE.*",
                "COPYING",
                "COPYING.*",
                "NOTICE",
                "NOTICE.*"
              ]
            },
            {
              "name": "Bill of materials",
              "kind": "path_glob",
              "terms": [
                "*.spdx",
                "*.spdx.json",
                "sbom*.json",
                "*.cdx.json",
                "bom.json"
              ]
            }
          ],
          "cross_references": [
            "stack.dependencies"
          ]
        }
      ]
    },
    {
      "id": "state",
      "number": "4",
