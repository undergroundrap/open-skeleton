{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/undergroundrap/open-skeleton/schemas/claim.schema.json",
  "title": "Open Skeleton Claim",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "snapshot_id",
    "claim",
    "category",
    "status",
    "confidence",
    "importance",
    "produced_by",
    "supporting_evidence",
    "contradicting_evidence",
    "invalidation_keys"
  ],
  "properties": {
    "claim_id": { "type": "string", "minLength": 16 },
    "snapshot_id": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "claim": { "type": "string", "minLength": 1 },
    "category": { "type": "string", "minLength": 1 },
    "status": {
      "enum": ["verified", "inferred", "conflict", "unknown", "stale"]
    },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "importance": { "enum": ["critical", "high", "medium", "low"] },
    "produced_by": { "type": "string", "minLength": 1 },
    "supporting_evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 16 },
      "uniqueItems": true
    },
    "contradicting_evidence": {
      "type": "array",
      "items": { "type": "string", "minLength": 16 },
      "uniqueItems": true
    },
    "invalidation_keys": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "alternative_hypotheses": {
      "type": "array",
      "items": { "type": "string" },
      "default": []
    }
  }
}

